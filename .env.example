# =============================================================================
# tgfarm — environment template.  cp .env.example .env  then fill in.
# EVERYTHING has a safe offline default. The farm runs end-to-end with only
# DATABASE_URL set; missing keys degrade gracefully instead of crashing.
# =============================================================================

# --- runtime -----------------------------------------------------------------
# "live"  = real calls to Telegram / LLM / image APIs
# "dry"   = generate + validate + render + schedule everything, but never send
# "off"   = no network at all (used by tests)
TGFARM_MODE=live

DATABASE_URL=sqlite:///./tgfarm.db
# Postgres in production (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://tgfarm:tgfarm@postgres:5432/tgfarm

# --- verified backups ---------------------------------------------------------
# Local snapshots; defaults to ROOT/backup when BACKUP_DIR is empty.
BACKUP_DIR=
# Optional second copy on a separate mounted disk / network share. Empty = disabled.
# When configured, failure of the mirror is reported as a failed backup job even
# though the verified local snapshot is kept.
BACKUP_MIRROR_DIR=
KEEP_BACKUPS=8
# Daily backup is considered stale after this many hours without a verified success.
BACKUP_MAX_AGE_HOURS=36
# Watchdog disk-space thresholds in GiB. Set both to 0 to disable.
DISK_FREE_WARN_GB=10
DISK_FREE_CRITICAL_GB=3

TZ=Europe/Moscow

# --- admin API / dashboard ---------------------------------------------------
# Binds to loopback by default. The API can force-publish, so exposing it to a
# network is a deliberate act; the token below protects it either way.
TGFARM_API_HOST=127.0.0.1
TGFARM_API_PORT=8000
# Leave empty to use the generated token in data/api_token. Set it to pin one
# secret (useful for the packaged desktop build, which passes it in-process).
TGFARM_API_TOKEN=
TGFARM_REQUIRE_TOKEN=true

# --- Telegram Bot API (optional; required for real publishing) ----------------
# Publishing always goes through the bot. That is deliberate: a banned bot costs
# a bot, a banned *account* costs the channel and its subscribers.
TELEGRAM_BOT_TOKEN=
# Comma separated numeric channel ids the bot administers
TELEGRAM_CHANNELS=

# --- Telegram account session (READ ONLY) ------------------------------------
# Fills the three gaps a bot cannot: the real channel list, live post
# statistics, and Telegram channels as a content source.
# api_id / api_hash come from https://my.telegram.org → API development tools,
# then: tgfarm telegram login
# The session file lands in data/telegram/ — it IS the account. Never commit it
# and never send it to anyone. Everything mutating is blocked in code; see
# tgfarm/tguser/__init__.py.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# --- LLM ---------------------------------------------------------------------
# Provider chain is tried in order; first healthy provider wins, and every
# failure falls through to the next one before the offline composer takes over.
# Supported: opencode (Zen), anthropic, openai, longcat, compatible, ollama, offline
LLM_PROVIDERS=opencode,anthropic,openai,offline

# OpenCode Zen — https://opencode.ai/inference
# The key is a service account key from the OpenCode Console and it is required:
# paid models answer 401 without it, and `-free` models answer 403 because the
# free tier only serves requests made from inside OpenCode. With no key the
# provider is skipped without a request.
OPENCODE_ZEN_TOKEN=
OPENCODE_ZEN_MODEL=claude-sonnet-4-6
# true = restrict to `-free` models to stay inside a small budget
OPENCODE_ZEN_FREE_ONLY=false
OPENCODE_ZEN_BASE_URL=https://opencode.ai/inference

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# LongCat — https://longcat.ai/platform
# OpenAI-compatible endpoint. The public model list currently contains only
# LongCat-2.5-Preview and LongCat-2.0, both billed per token; there is no
# documented free model. `thinking=false` keeps responses fast and avoids the
# hidden reasoning trace; JSON mode is prompt-based because response_format is
# not in the supported parameter list.
LONGCAT_API_KEY=
LONGCAT_MODEL=LongCat-2.5-Preview
LONGCAT_THINKING=false
#LLM_PROVIDERS=longcat,offline

OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Any OpenAI-compatible endpoint, enabled by putting `compatible` in
# LLM_PROVIDERS. Base URLs that work as-is:
#   Google Gemini  https://generativelanguage.googleapis.com/v1beta/openai
#   Groq           https://api.groq.com/openai/v1
#   OpenRouter     https://openrouter.ai/api/v1      (free models end in :free)
#   Together       https://api.together.xyz/v1
#   local vLLM     http://127.0.0.1:8000/v1          (no key needed)
#LLM_PROVIDERS=compatible
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_API_KEY=
#LLM_MODEL=gemini-2.5-flash

# --- embeddings --------------------------------------------------------------
# "openai" | "local" (hashed n-gram, no key needed, no download needed)
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- image generation (optional) ---------------------------------------------
# Pillow templates are the default and always work. Set IMAGE_ENABLED=true and
# pick a provider to add generated art for the subset of posts that templates
# cannot carry.
#
# openai:     POST {IMAGE_BASE_URL}/images/generations
# cloudflare: Workers AI POST /accounts/{id}/ai/run/{model}
IMAGE_ENABLED=false
IMAGE_PROVIDER=openai
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1280x720
IMAGE_QUALITY=standard
IMAGE_TIMEOUT_S=90

# Cloudflare Workers AI image generation.
# Free plan: 10,000 Neurons/day. FLUX.1 [schnell] at 1280x720 with 4 steps is
# roughly 55-60 Neurons per cover, so the daily allocation is ~150 images.
# Account ID: Cloudflare dashboard > Workers & Pages > Account details.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
# For Cloudflare set IMAGE_ENABLED=true and IMAGE_PROVIDER=cloudflare.

# --- article lead photos (Dzen) ---------------------------------------------
# Publisher feed images become the inline photo in a Dzen article. The template
# cover remains the fallback when no usable photo is found.
ARTICLE_IMAGE_ENABLED=true
ARTICLE_IMAGE_MAX_MB=12
ARTICLE_IMAGE_MAX_WIDTH=1600
ARTICLE_IMAGE_TIMEOUT_S=20

# --- licensed video (optional) ----------------------------------------------
# Video is opt-in and licence-checked: media must live on the article's own
# domain or the page must declare a Creative Commons / public-domain licence.
# Platform embeds (YouTube, TikTok, Vimeo, VK, Dzen, Rutube) are always refused.
# VIDEO_ALLOW_UNKNOWN=true lifts the cross-domain rule — only do this with
# rights you control.
# Original text-led Shorts can be rendered with: tgfarm video-render POST_ID
# This renderer needs FFmpeg in PATH and currently produces silent captions/cards.
VIDEO_ENABLED=false
VIDEO_MAX_MB=45
VIDEO_MAX_DURATION_S=180
VIDEO_DOWNLOAD_DIR=
VIDEO_ALLOW_UNKNOWN=false

# --- crossposting (optional; each adapter self-disables without credentials) --
# Dzen is a primary publishing platform now, not a crosspost target: the Zen
# persona is generated by S4 and published by S7.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Mastodon OAuth; connect from the dashboard, never enter the server password.
MASTODON_INSTANCE=
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_ACCESS_TOKEN=
# Mastodon OAuth; connect from the dashboard, never enter the server password.
MASTODON_INSTANCE=
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_ACCESS_TOKEN=
VK_ACCESS_TOKEN=
VK_GROUP_ID=
MAX_ACCESS_TOKEN=
MAX_CHANNEL_ID=
# YouTube Data API OAuth. Configure this callback in Google Cloud OAuth client:
# http://127.0.0.1:8000/api/platforms/youtube/auth/callback
# Use an OAuth web application, enable YouTube Data API v3, then connect from the Platforms tab.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TOKEN_EXPIRES_AT=0
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_TITLE=
# private by default; use unlisted/public only after explicitly changing this setting.
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=25
 
# TikTok Content Posting API OAuth. Add this callback URI to the developer app:
# http://127.0.0.1:8000/api/platforms/tiktok/auth/callback
# Direct-post requires user.info.basic + video.publish; every video has a separate consent step.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_TOKEN_EXPIRES_AT=0
TIKTOK_REFRESH_TOKEN_EXPIRES_AT=0
TIKTOK_OPEN_ID=
TIKTOK_USERNAME=
# X OAuth 2.0 (user context), required for creating posts; old app Bearer token is read-only.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_TOKEN_EXPIRES_AT=0
X_BEARER_TOKEN=
X_USER_ID=
# LinkedIn member OAuth (requires OpenID Connect + Share on LinkedIn access).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_TOKEN_EXPIRES_AT=0
LINKEDIN_REFRESH_TOKEN_EXPIRES_AT=0
LINKEDIN_MEMBER_ID=
LINKEDIN_MEMBER_NAME=
# Reddit OAuth: register an app and use a permanent refresh token (scope: submit).
# Never put your Reddit password here. Keep publishing disabled until credentials are checked.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_SUBREDDIT=
# Set a truthful, unique User-Agent such as:
# python:tgfarm:1.0 (by /u/YOUR_REDDIT_USERNAME)
THREADS_APP_ID=
THREADS_APP_SECRET=
# Filled after OAuth. Never copy an access token into chat or commit it.
THREADS_ACCESS_TOKEN=
THREADS_TOKEN_EXPIRES_AT=0
THREADS_USER_ID=
THREADS_USERNAME=

REDDIT_USER_AGENT=

# --- Dzen publishing (browser automation; no public API exists) ---------------
# Run `tgfarm dzen-login` once: a headed Chrome window opens, you log in to
# Yandex, and cookies stay in DZEN_PROFILE_DIR. Publishing then types the
# article into dzen.ru/profile/editor and stops on a captcha for manual action.
DZEN_PROFILE_DIR=
DZEN_BROWSER=chrome
DZEN_HEADLESS=false
DZEN_PUBLISH_TIMEOUT_S=600
DZEN_LOGIN_TIMEOUT_S=600
DZEN_HUMAN_DELAY_MS=90
# Numeric id from dzen.ru/profile/editor/id/<id>/... . Leave empty to discover
# it from the authenticated Studio page.
DZEN_PUBLISHER_ID=
# Read impressions/openings/read-through/comments/likes/shares from Dzen Studio.
# Automatic collection only runs in live mode; `tgfarm dzen-stats` forces it.
DZEN_STATS_ENABLED=true
DZEN_STATS_INTERVAL_MIN=30
DZEN_STATS_TIMEOUT_S=60

# --- search / factcheck (optional) --------------------------------------------
# Enables the S5 external verification gate, and the `websearch` source
# collector when a source of that kind is configured. With no key the websearch
# source returns nothing and the rest of the farm is unaffected.
TAVILY_API_KEY=
SERPER_API_KEY=
WEB_SEARCH_MAX_RESULTS=8

# --- pipeline tunables -------------------------------------------------------
HEAT_THRESHOLD=0.62
CLUSTER_SIMILARITY=0.82
DUPLICATE_SIMILARITY=0.88
SAMENESS_THRESHOLD=0.87
COLLECT_INTERVAL_MIN=10
MAX_POSTS_PER_CHANNEL_DAY=4

# --- Horizon-2 additions (27.10.2026) ----------------------------------------
# LLM_PROXY=                          # http://127.0.0.1:7890 — если шлюз гео-блокирован
# LLM_CRITIC_MODEL=                   # модель критика (пусто = общая цепочка)
# LLM2_BASE_URL=                      # второй эшелон провайдеров (OrcaRouter)
# LLM2_API_KEY=
# LLM2_MODEL=orcarouter/free
# TGFARM_APPROVAL_REQUIRED=false     # true = посты ждут кнопки в панели
# DZEN_MIN_GAP_S=600                 # пауза между публикациями в Дзен
PRIMARY_PUBLISH_MAX_ATTEMPTS=5        # stop after repeated definite failures
# DZEN_REQUIRES_LLM=true
# DZEN_CAPTCHA_WAIT_S=180             # сколько ждать нажатия «Я не робот»             # Дзен не публикует офлайн-текст
# VK_PRIME_HOURS=12,19               # прайм-часы ВК (30% постов)
# VK_PRIME_SHARE=0.3
# HOLDOUT_SHARE=0.1                  # контрольная группа без few-shot
# ALERT_CHAT_ID=                     # куда слать алерты (Telegram chat id)
# SOURCE_MAX_AGE_HOURS=72            # reject news drafts if every dated source is older
# ALERT_NO_PUBLISH_HOURS=3
# Alert when too many scheduled posts are waiting to publish.
QUEUE_BACKLOG_ALERT_THRESHOLD=100
# Alert when too many drafts are waiting for editorial approval.
EDITORIAL_BACKLOG_ALERT_THRESHOLD=50
# Warn when configured platform authorization health checks stop running (hours).
PLATFORM_AUTH_MAX_AGE_HOURS=12
# ALERT_HEARTBEAT_HOURS=24
# STALE_CLUSTER_HOURS=72
# RETENTION_RAW_DAYS=90
# RETENTION_RUNS_DAYS=30
