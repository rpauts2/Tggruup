# =============================================================================
# tgfarm — environment template.  cp .env.example .env  then fill in.
# EVERYTHING has a safe offline default. The farm runs end-to-end with only
# DATABASE_URL set; missing keys degrade gracefully instead of crashing.
# =============================================================================

# --- runtime -----------------------------------------------------------------
# Safe first-run default: "dry" generates + validates + renders + schedules but never sends posts.
# "live" enables real publication and external API calls; switch to it only deliberately.
# "off" disables network access (used by tests).
TGFARM_MODE=dry

DATABASE_URL=sqlite:///./tgfarm.db
# Postgres in production (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://tgfarm:tgfarm@postgres:5432/tgfarm

# --- verified backups ---------------------------------------------------------
# Local snapshots; defaults to ROOT/backup when BACKUP_DIR is empty.
BACKUP_DIR=
# Optional second copy on a separate mounted disk / network share. Empty = disabled.
# When configured, failure of the mirror is reported as a failed backup job even
# though the verified local snapshot is kept.
BACKUP_MIRROR_DIR=
KEEP_BACKUPS=8
# Daily backup is considered stale after this many hours without a verified success.
BACKUP_MAX_AGE_HOURS=36
# Watchdog disk-space thresholds in GiB. Set both to 0 to disable.
DISK_FREE_WARN_GB=10
DISK_FREE_CRITICAL_GB=3

TZ=Europe/Moscow

# --- admin API / dashboard ---------------------------------------------------
# Binds to loopback by default. The API can force-publish, so exposing it to a
# network is a deliberate act; the token below protects it either way.
TGFARM_API_HOST=127.0.0.1
TGFARM_API_PORT=8000
# Leave empty to use the generated token in data/api_token. Set it to pin one
# secret (useful for the packaged desktop build, which passes it in-process).
TGFARM_API_TOKEN=
TGFARM_REQUIRE_TOKEN=true
# Extra Host header values the dashboard answers on. The loopback names and
# TGFARM_API_HOST are always allowed; this is only for LAN names when the
# operator binds 0.0.0.0 on purpose. The check blocks DNS-rebinding, where a
# public site resolves to 127.0.0.1 and the browser forwards its cookies.
TGFARM_ALLOWED_HOSTS=

# --- Telegram Bot API (optional; required for real publishing) ----------------
# Publishing always goes through the bot. That is deliberate: a banned bot costs
# a bot, a banned *account* costs the channel and its subscribers.
TELEGRAM_BOT_TOKEN=
# Comma separated numeric channel ids the bot administers
TELEGRAM_CHANNELS=

# --- Telegram account session (READ ONLY) ------------------------------------
# Fills the three gaps a bot cannot: the real channel list, live post
# statistics, and Telegram channels as a content source.
# api_id / api_hash come from https://my.telegram.org → API development tools,
# then: tgfarm telegram login
# The session file lands in data/telegram/ — it IS the account. Never commit it
# and never send it to anyone. Everything mutating is blocked in code; see
# tgfarm/tguser/__init__.py.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# What the dashboard reports about the session. Note this flag is not the
# switch: tguser.connect() hands back a ReadOnlyClient either way, so setting it
# to false here does not enable mutating calls. The read-only guarantee lives in
# the code, which is what makes "the session file IS the account" survivable.
TELEGRAM_USER_READONLY=true
# Opt-in discovery of large public Telegram groups as upstream material. Off by
# default: the list is dynamic and expensive to enumerate, so it runs on its own
# slow schedule and never blocks the main collection cycle.
TELEGRAM_TOP_GROUPS_ENABLED=false
TELEGRAM_TOP_GROUPS_LIMIT=10
TELEGRAM_TOP_GROUP_MIN_PARTICIPANTS=1000
TELEGRAM_TOP_GROUPS_INTERVAL_MIN=180

# --- LLM ---------------------------------------------------------------------
# Provider chain is tried in order; first healthy provider wins, and every
# failure falls through to the next one before the offline composer takes over.
# Supported: opencode (Zen), anthropic, openai, longcat, compatible, ollama, offline
# Safe first run uses the offline composer; uncomment/replace this only after reviewing model costs.
LLM_PROVIDERS=offline
# LLM_PROVIDERS=opencode,anthropic,openai,offline

# OpenCode Zen — https://opencode.ai/inference
# The key is a service account key from the OpenCode Console and it is required:
# paid models answer 401 without it, and `-free` models answer 403 because the
# free tier only serves requests made from inside OpenCode. With no key the
# provider is skipped without a request.
OPENCODE_ZEN_TOKEN=
OPENCODE_ZEN_MODEL=claude-sonnet-4-6
# true = spend nothing on Zen: the provider resolves to a `-free` catalogue
# model and refuses any paid model, including OPENCODE_ZEN_MODEL above. The key
# is still required — `-free` models answer 403 without authentication.
OPENCODE_ZEN_FREE_ONLY=false
# The Zen endpoint is fixed in code (https://opencode.ai/inference); there is
# deliberately no env override for it.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# LongCat — https://longcat.ai/platform
# OpenAI-compatible endpoint. The public model list currently contains only
# LongCat-2.5-Preview and LongCat-2.0, both billed per token; there is no
# documented free model. `thinking=false` keeps responses fast and avoids the
# hidden reasoning trace; JSON mode is prompt-based because response_format is
# not in the supported parameter list.
LONGCAT_API_KEY=
LONGCAT_MODEL=LongCat-2.5-Preview
LONGCAT_THINKING=false
#LLM_PROVIDERS=longcat,offline

# Local Ollama install. `localhost` is the direct-install default; if you run
# Ollama in another container, put that service's name here instead.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Per-request HTTP budgets. These three take no alias: the env name is the
# field name, upper case, exactly as written here.
LLM_TIMEOUT_S=60
# Attempts per request, counted across the chain: each attempt takes the next
# healthy provider, and the offline composer answers once they are used up.
LLM_MAX_RETRIES=3
HTTP_TIMEOUT_S=25

# Any OpenAI-compatible endpoint, enabled by putting `compatible` in
# LLM_PROVIDERS. Base URLs that work as-is:
#   Google Gemini  https://generativelanguage.googleapis.com/v1beta/openai
#   Groq           https://api.groq.com/openai/v1
#   OpenRouter     https://openrouter.ai/api/v1      (free models end in :free)
#   Together       https://api.together.xyz/v1
#   local vLLM     http://127.0.0.1:8000/v1          (no key needed)
#LLM_PROVIDERS=compatible
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_API_KEY=
#LLM_MODEL=gemini-2.5-flash

# --- embeddings --------------------------------------------------------------
# "openai" | "local" (hashed n-gram, no key needed, no download needed)
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- image generation (optional) ---------------------------------------------
# Pillow templates are the default and always work. Set IMAGE_ENABLED=true and
# pick a provider to add generated art for the subset of posts that templates
# cannot carry.
#
# openai:     POST {IMAGE_BASE_URL}/images/generations
# cloudflare: Workers AI POST /accounts/{id}/ai/run/{model}
IMAGE_ENABLED=false
# Maximum image-provider requests per UTC day; failed/ambiguous attempts count.
IMAGE_DAILY_BUDGET=20
IMAGE_PROVIDER=openai
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1280x720
IMAGE_QUALITY=standard
IMAGE_TIMEOUT_S=90

# Cloudflare Workers AI image generation.
# Free plan: 10,000 Neurons/day. FLUX.1 [schnell] at 1280x720 with 4 steps is
# roughly 55-60 Neurons per cover, so the daily allocation is ~150 images.
# Account ID: Cloudflare dashboard > Workers & Pages > Account details.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
# For Cloudflare set IMAGE_ENABLED=true and IMAGE_PROVIDER=cloudflare.

# --- article lead photos (Dzen) ---------------------------------------------
# Publisher feed images become the inline photo in a Dzen article. The template
# cover remains the fallback when no usable photo is found.
ARTICLE_IMAGE_ENABLED=true
ARTICLE_IMAGE_MAX_MB=12
ARTICLE_IMAGE_MAX_WIDTH=1600
ARTICLE_IMAGE_TIMEOUT_S=20

# --- licensed video (optional) ----------------------------------------------
# Video is opt-in and licence-checked: media must live on the article's own
# domain or the page must declare a Creative Commons / public-domain licence.
# Platform embeds (YouTube, TikTok, Vimeo, VK, Dzen, Rutube) are always refused.
# VIDEO_ALLOW_UNKNOWN=true lifts the cross-domain rule — only do this with
# rights you control.
# Original text-led Shorts can be rendered with: tgfarm video-render POST_ID
# This renderer needs FFmpeg in PATH and currently produces silent captions/cards.
VIDEO_ENABLED=false
VIDEO_MAX_MB=45
VIDEO_MAX_DURATION_S=180
VIDEO_DOWNLOAD_DIR=
VIDEO_ALLOW_UNKNOWN=false

# --- crossposting (optional; each adapter self-disables without credentials) --
# Dzen is a primary publishing platform now, not a crosspost target: the Zen
# persona is generated by S4 and published by S7.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Mastodon OAuth; connect from the dashboard, never enter the server password.
MASTODON_INSTANCE=
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_ACCESS_TOKEN=
VK_ACCESS_TOKEN=
VK_GROUP_ID=
# Metrics need a second, user-scoped token: wall.getById answers error 27 for a
# group token, so VK_ACCESS_TOKEN alone buys publishing but no analytics.
VK_USER_TOKEN=

# YouTube Data API: set up a Google OAuth Web application and add this callback
# URL to its authorised redirect URIs:
# http://127.0.0.1:8000/api/platforms/youtube/auth/callback
# The dashboard stores the OAuth tokens locally after consent: CLIENT_ID and
# CLIENT_SECRET are yours to set, ACCESS_TOKEN / REFRESH_TOKEN / TOKEN_EXPIRES_AT
# are written by the Platforms tab and should be left empty here.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TOKEN_EXPIRES_AT=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_TITLE=
# unlisted is the code default: an upload is reachable by anyone who has the
# link. Choose private deliberately when a draft must not be shareable at all,
# and public only once the channel is meant to publish.
YOUTUBE_PRIVACY_STATUS=unlisted
# 28 = Science & Technology; matches the default in tgfarm/core/settings.py.
YOUTUBE_CATEGORY_ID=28

# TikTok Content Posting API: the registered app must have video.publish
# approval and the callback URL allow-listed:
# http://127.0.0.1:8000/api/platforms/tiktok/auth/callback
# Direct publishing requires an explicit per-post action from the dashboard:
# user.info.basic + video.publish scopes, and every video has its own consent step.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_TOKEN_EXPIRES_AT=0
TIKTOK_REFRESH_TOKEN_EXPIRES_AT=0
TIKTOK_OPEN_ID=
TIKTOK_USERNAME=

# Douyin Open Platform: OAuth scopes user_info and video.create.
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_ACCESS_TOKEN=
DOUYIN_REFRESH_TOKEN=
DOUYIN_TOKEN_EXPIRES_AT=0
DOUYIN_REFRESH_TOKEN_EXPIRES_AT=0
DOUYIN_OPEN_ID=
DOUYIN_USERNAME=

# MAX Bot API. MAX_CHANNEL_ID is written after webhook discovery and the owner selects a chat.
MAX_ACCESS_TOKEN=
MAX_CHANNEL_ID=
# Filled in by the dashboard when the webhook is registered — leave empty by hand.
MAX_BOT_ID=
MAX_CHANNEL_NAME=
MAX_CHANNEL_IS_CHANNEL=false
MAX_CHANNEL_BLOCKED=false
# Outgoing webhook: the secret signs the payload, the URL is what MAX is told to post to.
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_URL=
# Chats the bot has discovered, kept as a JSON array by the dashboard.
MAX_DISCOVERED_CHATS=[]
DISCORD_WEBHOOK_URL=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_BOARD_ID=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_TOKEN_EXPIRES_AT=0
PINTEREST_REFRESH_TOKEN_EXPIRES_AT=0
OK_APPLICATION_KEY=
OK_APPLICATION_SECRET=
OK_ACCESS_TOKEN=
OK_SESSION_SECRET_KEY=
OK_GROUP_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_NAME=
FACEBOOK_USER_ACCESS_TOKEN=
FACEBOOK_USER_TOKEN_EXPIRES_AT=0

# X OAuth 2.0 (user context), required for creating posts. There is no app-only
# Bearer token setting: every tweet is posted with the OAuth access token below,
# refreshed from the refresh token, so `X_BEARER_TOKEN` is not read by any code.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_TOKEN_EXPIRES_AT=0
X_USER_ID=
# LinkedIn member OAuth (requires OpenID Connect + Share on LinkedIn access).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_TOKEN_EXPIRES_AT=0
LINKEDIN_REFRESH_TOKEN_EXPIRES_AT=0
LINKEDIN_MEMBER_ID=
LINKEDIN_MEMBER_NAME=

# Instagram Login requires a professional Business/Creator profile and Content Publishing access.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_TOKEN_EXPIRES_AT=0
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=

# Public HTTPS origin for provider callbacks and media delivery.
# MAX uses this same origin for /api/platforms/max/webhook and requires trusted TLS on port 443.
# It must be the public reverse-proxy origin only, e.g. https://farm.example (no path, port or trailing slash).
TGFARM_PUBLIC_BASE_URL=
# Reddit OAuth: register an app and use a permanent refresh token (scopes: read, submit).
# Reddit Data API access requires explicit approval. Leave false until Reddit approves this app/use case.
# TgFarm also keeps Reddit out of unattended cross-posting; use the single-community reviewed workflow.
REDDIT_API_APPROVED=false
# Never put your Reddit password here. Keep publishing disabled until credentials are checked.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_SUBREDDIT=
# Set a truthful, unique User-Agent such as:
# python:tgfarm:1.0 (by /u/YOUR_REDDIT_USERNAME)
THREADS_APP_ID=
THREADS_APP_SECRET=
# Filled after OAuth. Never copy an access token into chat or commit it.
THREADS_ACCESS_TOKEN=
THREADS_TOKEN_EXPIRES_AT=0
THREADS_USER_ID=
THREADS_USERNAME=

REDDIT_USER_AGENT=

# --- WeChat Official Account articles (NOT WeChat Channels or mass messaging) ---
# Requires freepublish permission and the server's public IP in the Official Account allowlist.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=

# --- Medium legacy API (only tokens issued for existing integrations) ----------
# Medium no longer accepts new API integrations or issues new integration tokens.
# Leave blank unless you already have a valid legacy MEDIUM_ACCESS_TOKEN.
MEDIUM_ACCESS_TOKEN=

# --- Tumblr API v2 OAuth 2.0 --------------------------------------------------
# Register an OAuth app and allow the panel callback URL. Scopes: basic write offline_access.
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=
# Optional; leave empty to use the primary blog granted by OAuth.
TUMBLR_BLOG_IDENTIFIER=
# Filled after OAuth. Never copy tokens into chat or commit them.
TUMBLR_ACCESS_TOKEN=
TUMBLR_REFRESH_TOKEN=
TUMBLR_TOKEN_EXPIRES_AT=0
TUMBLR_USERNAME=
TUMBLR_BLOG_TITLE=
TUMBLR_BLOG_URL=

# --- Dzen publishing (browser automation; no public API exists) ---------------
# Run `tgfarm dzen-login` once: a headed Chrome window opens, you log in to
# Yandex, and cookies stay in DZEN_PROFILE_DIR. Publishing then types the
# article into dzen.ru/profile/editor and stops on a captcha for manual action.
DZEN_PROFILE_DIR=
DZEN_BROWSER=chrome
DZEN_HEADLESS=false
DZEN_PUBLISH_TIMEOUT_S=600
DZEN_LOGIN_TIMEOUT_S=600
# Per-keystroke pacing in the editor, in ms — the human-behaviour budget the
# browser automation keeps to. Matches the default in tgfarm/core/settings.py.
DZEN_HUMAN_DELAY_MS=70
# Numeric id from dzen.ru/profile/editor/id/<id>/... . Leave empty to discover
# it from the authenticated Studio page.
DZEN_PUBLISHER_ID=
# Read impressions/openings/read-through/comments/likes/shares from Dzen Studio.
# Automatic collection only runs in live mode; `tgfarm dzen-stats` forces it.
DZEN_STATS_ENABLED=true
DZEN_STATS_INTERVAL_MIN=30
DZEN_STATS_TIMEOUT_S=60

# --- search / factcheck (optional) --------------------------------------------
# Enables the S5 external verification gate, and the `websearch` source
# collector when a source of that kind is configured. With no key the websearch
# source returns nothing and the rest of the farm is unaffected.
TAVILY_API_KEY=
SERPER_API_KEY=
WEB_SEARCH_MAX_RESULTS=8

# --- AI policy ---------------------------------------------------------------
# `selective` spends online calls only where the deterministic composer is weak
# (analysis/history, multi-source stories, short drafts). `always` restores the
# old behaviour; `off` is a hard local-only mode.
AI_POLICY=selective
AI_DAILY_BUDGET=30
# S5 critic gates on a 0-10 scale. These two env keys are documented as the
# defaults they mirror, but nothing reads them: the gates compare against the
# RELEVANCE_THRESHOLD / QUALITY_THRESHOLD constants in tgfarm/s5_quality.
AI_RELEVANCE_THRESHOLD=7.0
AI_QUALITY_THRESHOLD=7.5

# --- pipeline tunables -------------------------------------------------------
# A cluster must reach this heat score before it is allowed into content
# generation; below it the story waits in the cluster for more sources.
HEAT_THRESHOLD=0.68
# The cosine cut S4 uses to drop a draft that is too close to what the channel
# already published — both the in-cycle check and the full-archive check read it
# on every draft. No CLUSTER_SIMILARITY knob: S2 clusters news headlines on
# IDF-weighted lexical overlap, because cosine cannot separate a related
# headline pair (0.22-0.36) from a random pair (0.36) at any threshold.
DUPLICATE_SIMILARITY=0.88
# Rewriting stored `duplicate_of` links touches tens of thousands of history
# rows. Off until you turn it on deliberately, with a fresh copy of the database
# taken first; the repair also previews without writing (`tgfarm repair-duplicates`).
DUPLICATE_REPAIR_APPLY=false
# The same §80 consent for the other history rewrite: rows stored as published that
# carry no remote id of any kind. Read straight from the environment by
# tgfarm/maintenance.py, not through Settings. Off means the sweep never writes —
# `tgfarm publication-evidence` still prints its report, and the damage stays in the
# database until you set it. On reclassifies those rows to publish_unknown on every
# maintenance pass, and only while a copy of this database is fresh in backup/.
PUBLICATION_EVIDENCE_REPAIR_APPLY=false
# The same §80 consent for returning terminal publish failures (`status = failed`) to
# the queue. Read straight from the environment by tgfarm/maintenance.py, not through
# Settings. `failed` is what our own retry classifier decided, not what the platform
# proved, so a requeue repeats a publication — which is why an unknown outcome
# (`publish_unknown`) is never requeued through this path, and why the sweep also
# refuses rows that carry a Telegram message id, a `posted` journal row, or an error
# saying the driver died mid-flight. Off means `tgfarm requeue-failed` and the panel
# button only preview: the rows stay failed and the operator keeps reading the count
# without a way to work through it. On lets an apply pass move up to --limit rows
# (max 200) back to `scheduled` with a fresh attempt budget — and only while a copy of
# this database is fresh in backup/ and the operator has typed a reason, since these
# rows were closed out as stale material.
PUBLISH_FAILURE_REQUEUE_APPLY=false
SAMENESS_THRESHOLD=0.87
COLLECT_INTERVAL_MIN=10
# Backstop only. The schedule that actually runs is posts_per_day in
# config/personas.yaml, and no pipeline code reads this key today.
MAX_POSTS_PER_CHANNEL_DAY=1000
# Slow a source down when it goes quiet or keeps failing, instead of hammering it.
SOURCE_ADAPTIVE_CADENCE=true
SOURCE_IDLE_BACKOFF_MAX=6
SOURCE_FAILURE_BACKOFF_MAX=4
# Auto-disable a source after this many consecutive failures, for this many hours.
SOURCE_AUTO_COOLDOWN_AFTER_FAILURES=5
SOURCE_AUTO_COOLDOWN_HOURS=24

# Let a measured format lesson move the plan. Off by default on purpose: with a
# few hundred published posts against a handful of measured ones, a two-post
# sample would steer every generation. S8 and S12 keep measuring either way.
FORMAT_PERFORMANCE_PLANNER=false
FORMAT_PERFORMANCE_WINDOW_DAYS=60
# The window above filters by the date a post was published; this one asks the
# second question — is its measurement still live? A snapshot older than this is
# history: it stays in the report, but the planner and the stored S12 lesson
# refuse to let it move a format. The collector has been silent for weeks, so
# without this the planner would rank formats on stale snapshots and memorise it.
FORMAT_EVIDENCE_STALE_AFTER_DAYS=7
# S5 gates drafts one by one; past this wall-clock bound the rest stay drafts and
# are picked up next cycle, so one slow provider cannot hold the whole pipeline.
QUALITY_STAGE_BUDGET_S=600
# Per-platform publication budgets. A timeout is never retried blindly: the post
# goes to publish_unknown for the operator to reconcile, because a slow submit
# may still have landed.
VK_PUBLISH_TIMEOUT_S=120
TELEGRAM_PUBLISH_TIMEOUT_S=60
PUBLISH_CANCEL_GRACE_S=15

# --- always-on supervision ---------------------------------------------------
# Hard wall-clock bound for a full cycle: past this it is timed out, not merely
# slow. The crosspost tick reuses it but clamps the result to 15 minutes.
CYCLE_TIMEOUT_MIN=60
# A cycle row still marked running after this is treated as stale, i.e. the
# process that wrote it died without closing it.
CYCLE_STALE_MIN=45
WATCHDOG_INTERVAL_MIN=5
# Restart backoff after a dead cycle: doubles from base up to max.
WATCHDOG_RECOVERY_BASE_MIN=5
WATCHDOG_RECOVERY_MAX_MIN=60
# Same alert code never re-sends within this window; the heartbeat ends longer
# silence with a "everything is fine" note instead.
ALERT_COOLDOWN_MIN=30

# --- Horizon-2 additions (27.10.2026) ----------------------------------------
# LLM_PROXY=                          # http://127.0.0.1:7890 — если шлюз гео-блокирован
# LLM_CRITIC_MODEL=                   # модель критика (пусто = общая цепочка)
# LLM_STRATEGIST_MODEL=               # отдельная модель редакционного стратега
# LLM_PLATFORM_EDITOR_MODEL=           # отдельная модель нативного редактора площадок
# LLM2_BASE_URL=                      # второй эшелон провайдеров (OrcaRouter)
# LLM2_API_KEY=
# LLM2_MODEL=orcarouter/free
# TGFARM_APPROVAL_REQUIRED=false     # true = посты ждут кнопки в панели
# DZEN_MIN_GAP_S=600                 # пауза между публикациями в Дзен
# Stop retrying a primary publication after this many definite failures.
PRIMARY_PUBLISH_MAX_ATTEMPTS=5
# DZEN_REQUIRES_LLM=true
# DZEN_CAPTCHA_WAIT_S=180             # сколько ждать нажатия «Я не робот»             # Дзен не публикует офлайн-текст
# VK_PRIME_HOURS=12,19               # прайм-часы ВК (30% постов)
# VK_PRIME_SHARE=0.3
# HOLDOUT_SHARE=0.1                  # контрольная группа без few-shot
# ALERT_CHAT_ID=                     # куда слать алерты (Telegram chat id)
# SOURCE_MAX_AGE_HOURS=72            # reject news drafts if every dated source is older
# ALERT_NO_PUBLISH_HOURS=3
# Alert when too many scheduled posts are waiting to publish.
QUEUE_BACKLOG_ALERT_THRESHOLD=100
# Alert when too many drafts are waiting for editorial approval.
EDITORIAL_BACKLOG_ALERT_THRESHOLD=50
# Warn when configured platform authorization health checks stop running (hours).
PLATFORM_AUTH_MAX_AGE_HOURS=12
# ALERT_HEARTBEAT_HOURS=24
# STALE_CLUSTER_HOURS=72
# RETENTION_RAW_DAYS=90
# RETENTION_RUNS_DAYS=30


# --- outbound HTTP and rendering ---------------------------------------------
# The identity every collector and media fetch presents (S1 sources, article
# images, video download). Reddit has its own, stricter REDDIT_USER_AGENT.
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36 tgfarm/1.0
# Absolute path to a .ttf/.otf carrying the glyphs your languages need. When
# empty, S6 and S11 walk their own candidate list first; only if none of those
# load do they log a warning and fall back to PIL's default face, which is a
# narrow fallback — check a rendered card for the scripts and emoji you use.
